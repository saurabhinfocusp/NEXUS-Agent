# Copy to .env and adjust as needed. Consumed by src/nexus_agent/shared/config.py
# and by docker-compose.yml for container credentials.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_agent
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password

REDIS_HOST=localhost
REDIS_PORT=6379

# S3-compatible object storage (MinIO locally via docker-compose; point
# S3_ENDPOINT_URL at a real S3-compatible service in other environments).
S3_ENDPOINT_URL=http://localhost:9000
S3_PORT=9000
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus_dev_password
S3_BUCKET=nexus-agent

# Torch/CellPose device for Vision's real inference path (Art. XII §2).
# "cpu" (default) works with the CPU-only torch/torchvision environment.yml
# installs by default. Set to "cuda" only after installing a CUDA-enabled
# torch/torchvision build matching your GPU's CUDA version.
NEXUS_DEVICE=cpu

# Morphology encoder: omiclip (default; downloads a pinned 7.7 GB checkpoint
# from Hugging Face on first use), vgg16 (low-compute fallback) or dinov2.
VISION_EMBEDDER=omiclip
# Optional: a local copy of the OmiCLIP checkpoint, to skip the download.
# OMICLIP_CHECKPOINT_PATH=/path/to/checkpoint.pt

# Optional: s3:// URI of a pretrained fusion base produced by
# scripts/pretrain_fusion.py. Leave unset to use the untrained fixed-seed
# base. Switching bases invalidates previously promoted cell-type
# checkpoints (they are ignored, not misapplied).
# FUSION_CHECKPOINT_URI=s3://nexus-agent/fusion/base.pt

# Optional LLM layer (needs `pip install -e ".[llm]"` and ANTHROPIC_API_KEY).
# Intake: turn the upload form's free-text question into the optional
# analyses to run. Narrative: add a verified prose summary to the report.
LLM_INTAKE_ENABLED=false
LLM_NARRATIVE_ENABLED=false
# LLM_MODEL=claude-opus-5-5
