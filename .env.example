# Copy to .env and adjust as needed. Consumed by src/nexus_agent/shared/config.py
# and by docker-compose.yml for container credentials.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_agent
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password

REDIS_HOST=localhost
REDIS_PORT=6379

# S3-compatible object storage (MinIO locally via docker-compose; point
# S3_ENDPOINT_URL at a real S3-compatible service in other environments).
S3_ENDPOINT_URL=http://localhost:9000
S3_PORT=9000
S3_ACCESS_KEY=nexus
S3_SECRET_KEY=nexus_dev_password
S3_BUCKET=nexus-agent
